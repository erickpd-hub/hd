# App Configuration
APP_ENV=development
APP_NAME="SupportL1 AI SaaS"
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=super-secret-jwt-key-replace-in-production-min-32-chars

# PostgreSQL with pgvector
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/support_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Models & Keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
TRIAGE_MODEL_NAME=gpt-4o-mini
L1_AGENT_MODEL_NAME=gpt-4o
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Confidence threshold for L1 agent answer vs escalation
L1_CONFIDENCE_THRESHOLD=0.75
